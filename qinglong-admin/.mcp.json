{
  "mcpServers": {
    "qinglong-admin": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.mjs"],
      "env": {
        "QL_URL": "${user_config.panel_url}",
        "QL_ACCESS_TOKEN": "${user_config.access_token}",
        "QL_CLIENT_ID": "${user_config.client_id}",
        "QL_CLIENT_SECRET": "${user_config.client_secret}",
        "QL_TIMEOUT_MS": "${user_config.timeout_ms}"
      },
      "timeoutMs": 60000
    }
  }
}
